# Neon Postgres 连接串（Neon 控制台 → Connection Details → 复制）
# 形如：postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auth.js 会话密钥（生产必填；本地开发可先填任意长随机串）
AUTH_SECRET=

# Auth.js 基础地址（生产必填；本地开发可省略，由请求自动推断）
AUTH_URL=

# ── 分析（⑦ GA4 + 热力）──
# GA4 测量 ID（仅生产环境加载，见 components/Analytics.tsx）
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity 热力图（可选；留空则不加载）
# NEXT_PUBLIC_CLARITY_ID=

# ── 广告（Google AdSense）──
# 在 Google AdSense 后台 → 站点 → 获取 ca-pub-XXXXXXXXXXXXXXXX 发布商 ID，填入下方
# 注意：仅生产环境会加载广告脚本（见 components/AdSense.tsx），本地预览不会展示广告
NEXT_PUBLIC_ADSENSE_CLIENT=
# AdSense 要求的 ads.txt 授权码（来自 AdSense 后台"网站"→ 你的站点 → 授权码，
# 形如 pub-XXXXXXXXXXXXXXXX 或直接粘贴整行授权内容）。留空则 /ads.txt 返回空。
ADS_TXT_CONTENT=

# ── 收付款（⑥ Polar.sh）──
# 1) Polar 后台 → Settings → Access Tokens 生成组织访问令牌（Organization Access Token）
# 2) Polar 后台 → Settings → Webhooks → Add Endpoint，
#    回调地址填：<你的域名>/api/webhook/polar ，订阅 subscription.* 事件，生成 Webhook Secret
#    （该 secret 为 base64，直接原样填入即可，路由会按标准 Webhooks 算法验签）
# 3) 在 Polar 后台 Products 创建两个订阅产品（Pro 月度 / Pro 年度），
#    复制各自的产品 ID 填入下方；sandbox 用沙箱环境的产品 ID
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_MONTHLY_PRODUCT_ID=
POLAR_PRO_YEARLY_PRODUCT_ID=
# sandbox（本地/测试）或 production（正式）
POLAR_ENV=sandbox
# 本站在 Polar 成功支付后的回跳地址（替换为你正式域名）
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# 配置完成并确认无误后改为 true，dashboard 才显示「升级 Pro」按钮
NEXT_PUBLIC_POLAR_ENABLED=false
